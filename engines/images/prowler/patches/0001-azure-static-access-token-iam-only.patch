+def _provider_arguments(**overrides):
+    arguments = {
+        "access_token_auth": True,
+        "access_token_expires_at": NOW + 60,
+        "subscription_id": [str(uuid4())],
+        "service": ["iam"],
+    }
+    arguments.update(overrides)
+    return Namespace(**arguments)
