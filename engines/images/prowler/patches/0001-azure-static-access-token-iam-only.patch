+class StaticAccessTokenCredential(TokenCredential):
+    """Non-refreshing Azure TokenCredential restricted to one ARM scope."""
+
+    _TOKEN_PATTERN = re.compile(r"[A-Za-z0-9\-._~+/]+=*")
+    _MAX_TOKEN_LENGTH = 64 * 1024
+
+    def __init__(self, token, expires_on, allowed_scopes):
+        if (
+            not isinstance(token, str)
+            or not token
+            or len(token) > self._MAX_TOKEN_LENGTH
+            or self._TOKEN_PATTERN.fullmatch(token) is None
+        ):
+            raise AzureArgumentTypeValidationError(
+                file=os.path.basename(__file__),
+                message="AZURE_ACCESS_TOKEN is missing or malformed",
+            )
+        if not access_token_expiry_is_valid(expires_on):
+            raise AzureArgumentTypeValidationError(
+                file=os.path.basename(__file__),
+                message="Azure access token expiry is expired, malformed, or exceeds 3600 seconds",
+            )
+        if (
+            not isinstance(allowed_scopes, list)
+            or len(allowed_scopes) != 1
+            or not isinstance(allowed_scopes[0], str)
+            or not allowed_scopes[0]
+        ):
+            raise AzureArgumentTypeValidationError(
+                file=os.path.basename(__file__),
+                message="Azure access token requires exactly one ARM credential scope",
+            )
+        self._token = token
+        self._expires_on = expires_on
+        self._allowed_scope = allowed_scopes[0]
+
+    def get_token(
+        self,
+        *scopes: str,
+        claims: str = None,
+        tenant_id: str = None,
+        enable_cae: bool = False,
+        **kwargs,
+    ) -> AccessToken:
+        if self._expires_on <= int(time()):
+            raise ClientAuthenticationError(
+                message="The static Azure access token has expired"
+            )
+        if (
+            scopes != (self._allowed_scope,)
+            or claims is not None
+            or tenant_id is not None
+            or enable_cae
+        ):
+            raise ClientAuthenticationError(
+                message="The static Azure access token cannot satisfy this token request"
+            )
+        return AccessToken(self._token, self._expires_on)
+
+    def close(self):
+        """Match Azure credential lifecycle APIs without acquiring resources."""
+
+
