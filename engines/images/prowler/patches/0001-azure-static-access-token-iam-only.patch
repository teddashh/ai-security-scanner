+                return_value=NOW,
+            ),
+            patch("sys.argv", ["prowler"]),
+        ):
+            parsed = ProwlerArgumentParser().parse(
+                [
+                    "prowler",
+                    "azure",
+                    "--access-token-auth",
+                    "--access-token-expires-at",
+                    str(NOW + 60),
+                    "--subscription-ids",
+                    subscription_id,
+                    "--service",
+                    "iam",
+                ]
+            )
+
+        assert parsed.access_token_auth
+        assert parsed.access_token_expires_at == NOW + 60
+        assert parsed.subscription_id == [subscription_id]
+        assert parsed.service == ["iam"]
+
+    @pytest.mark.parametrize(
