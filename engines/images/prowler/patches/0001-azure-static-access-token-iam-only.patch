+def access_token_expiry_is_valid(expires_at, now=None):
+    """Return whether an exact epoch expiry is currently usable and bounded."""
+    if type(expires_at) is not int:
+        return False
+    current_time = int(time()) if now is None else now
+    return current_time < expires_at <= current_time + ACCESS_TOKEN_MAX_LIFETIME_SECONDS
+
+
+def validate_access_token_expiry(value):
+    """Parse a canonical, future Unix-seconds expiry bounded to one hour."""
+    if (
+        not isinstance(value, str)
+        or not value.isascii()
+        or not value.isdecimal()
+        or str(int(value)) != value
+    ):
+        raise ArgumentTypeError("access token expiry must be canonical Unix seconds")
+    expires_at = int(value)
+    if not access_token_expiry_is_valid(expires_at):
+        raise ArgumentTypeError(
+            "access token expiry must be in the future and no more than 3600 seconds away"
+        )
+    return expires_at
+
+
+def exact_subscription_ids_are_valid(subscription_ids):
+    """Return whether IDs are a non-empty, duplicate-free canonical UUID list."""
+    if not isinstance(subscription_ids, list) or not subscription_ids:
+        return False
+    for subscription_id in subscription_ids:
+        try:
+            if (
+                not isinstance(subscription_id, str)
+                or str(UUID(subscription_id)) != subscription_id
+            ):
+                return False
+        except (AttributeError, ValueError):
+            return False
+    return len(set(subscription_ids)) == len(subscription_ids)
+
+
+def validate_arguments(arguments):
+    """Validate the downstream static access-token CLI contract."""
+    access_token_auth = getattr(arguments, "access_token_auth", False)
+    expires_at = getattr(arguments, "access_token_expires_at", None)
+
+    if not access_token_auth:
+        if expires_at is not None:
+            return (
+                False,
+                "--access-token-expires-at requires --access-token-auth",
+            )
+        return (True, "")
+
+    if not access_token_expiry_is_valid(expires_at):
+        return (
+            False,
+            "--access-token-auth requires a future --access-token-expires-at no more than 3600 seconds away",
+        )
+    if not exact_subscription_ids_are_valid(
+        getattr(arguments, "subscription_id", None)
+    ):
+        return (
+            False,
+            "--access-token-auth requires one or more canonical --subscription-ids",
+        )
+    if getattr(arguments, "service", None) != ["iam"]:
+        return (
+            False,
+            "--access-token-auth is restricted to exactly --service iam",
+        )
+    return (True, "")
