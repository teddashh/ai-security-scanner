+            f"0{NOW + 1}",
+            "1.5",
+            "not-an-epoch",
+            "",
+        ],
+    )
+    @patch("prowler.providers.azure.lib.arguments.arguments.time", return_value=NOW)
+    def test_expiry_rejects_malformed_expired_or_unbounded_values(
+        self, _mock_time, value
