+    def test_exact_project_constructor_never_reads_parent_organization(self):
+        project_id = "exact-project"
+        project = MagicMock(lifecycle_state="ACTIVE")
+        project.organization.id = "987654321"
+        service = MagicMock()
+        credentials = MagicMock()
+        credentials._service_account_email = "static-access-token"
+
+        with (
+            patch.object(
+                GcpProvider,
+                "setup_session",
+                return_value=(credentials, project_id),
+            ),
+            patch.object(
+                GcpProvider,
+                "get_projects",
+                return_value={project_id: project},
+            ),
+            patch(
+                "prowler.providers.gcp.gcp_provider.discovery.build",
+                return_value=service,
+            ) as mock_build,
+            patch("prowler.providers.gcp.gcp_provider.GCPMutelist"),
+        ):
+            provider = GcpProvider(
+                project_ids=[project_id],
+                config_content={"shodan_api_key": None},
+                mutelist_content={"Mutelist": {}},
+            )
+
+        assert provider.project_ids == [project_id]
+        mock_build.assert_not_called()
+        service.organizations.return_value.get.assert_not_called()
+
