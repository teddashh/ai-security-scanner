+fn required_port_key(protocol: Protocol, port: &str) -> KbKey {
+    if port.starts_with("Services/") {
+        return KbKey::Custom(port.to_string());
+    }
+    match protocol {
+        Protocol::UDP => KbKey::Port(kb::Port::Udp(port.to_string())),
+        Protocol::TCP => KbKey::Port(kb::Port::Tcp(port.to_string())),
+    }
+}
+
+async fn any_required_port_available<S>(
+    storage: &S,
+    key: &KbContext,
+    protocol: Protocol,
+    ports: &[String],
+) -> bool
+where
+    S: ContextStorage,
+{
+    if ports.is_empty() {
+        return true;
+    }
+    for port in ports {
+        let lookup = KbContextKey(key.clone(), required_port_key(protocol, port));
+        if let Ok(Some(mut values)) = storage.retrieve(&lookup).await
+            && values.pop().is_some_and(Into::into)
+        {
+            return true;
+        }
+    }
+    false
+}
