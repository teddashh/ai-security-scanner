+fn normalize_result_port(port: Option<i32>) -> Option<i32> {
+    port.filter(|port| (1..=i32::from(u16::MAX)).contains(port))
+}
+
+fn row_port(row: &SqliteRow) -> Option<i32> {
+    match row.try_get::<Option<i32>, _>("port") {
+        Ok(port) => {
+            let normalized = normalize_result_port(port);
+            if port.is_some() && normalized.is_none() {
+                tracing::warn!(?port, "ignoring invalid result port in SQLite");
+            }
+            normalized
+        }
+        Err(error) => {
+            tracing::warn!(%error, "ignoring result port with an invalid SQLite representation");
+            None
+        }
+    }
+}
