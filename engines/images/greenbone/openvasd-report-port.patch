+#[cfg(test)]
+mod tests {
+    use super::*;
+    use sqlx::sqlite::SqlitePoolOptions;
+
+    async fn result_pool() -> SqlitePool {
+        let pool = SqlitePoolOptions::new()
+            .max_connections(1)
+            .connect("sqlite::memory:")
+            .await
+            .unwrap();
+        sqlx::query(
+            r#"
+            CREATE TABLE results (
+                scan_id TEXT NOT NULL,
+                id INTEGER NOT NULL,
+                type TEXT,
+                ip_address TEXT,
+                hostname TEXT,
+                oid TEXT,
+                port INTEGER,
+                protocol TEXT,
+                message TEXT,
+                detail_name TEXT,
+                detail_value TEXT,
+                source_type TEXT,
+                source_name TEXT,
+                source_description TEXT,
+                PRIMARY KEY (scan_id, id)
+            )
+            "#,
+        )
+        .execute(&pool)
+        .await
+        .unwrap();
+        pool
+    }
+
+    #[tokio::test]
+    async fn result_port_round_trip_preserves_null_and_full_u16_range() {
+        let pool = result_pool().await;
+        let ports = [
+            None,
+            Some(1),
+            Some(32768),
+            Some(65535),
+            Some(0),
+            Some(-1),
+            Some(65536),
+        ];
+        let results = ports
+            .into_iter()
+            .map(|port| models::Result {
+                port,
+                ..Default::default()
+            })
+            .collect::<Vec<_>>();
+
+        try_store(&pool, "scan", &results).await.unwrap();
+
+        let stored = sqlx::query_scalar::<_, Option<i32>>(
+            "SELECT port FROM results WHERE scan_id = ? ORDER BY id",
+        )
+        .bind("scan")
+        .fetch_all(&pool)
+        .await
+        .unwrap();
+        assert_eq!(
+            stored,
+            vec![
+                None,
+                Some(1),
+                Some(32768),
+                Some(65535),
+                None,
+                None,
+                None,
+            ]
+        );
+    }
+
+    #[tokio::test]
+    async fn invalid_persisted_ports_are_not_exposed() {
+        let pool = result_pool().await;
+        for (id, port) in [0, -1, 65536].into_iter().enumerate() {
+            sqlx::query("INSERT INTO results (scan_id, id, type, port) VALUES (?, ?, ?, ?)")
+                .bind("corrupt")
+                .bind(id as i64)
+                .bind("log")
+                .bind(port)
+                .execute(&pool)
+                .await
+                .unwrap();
+        }
+
+        let rows = sqlx::query(
+            r#"
+            SELECT id, type, ip_address, hostname, oid, port, protocol, message,
+                detail_name, detail_value, source_type, source_name, source_description
+            FROM results
+            WHERE scan_id = ?
+            ORDER BY id
+            "#,
+        )
+        .bind("corrupt")
+        .fetch_all(&pool)
+        .await
+        .unwrap();
+        let ports = rows
+            .into_iter()
+            .map(row_to_result)
+            .map(|result| result.port)
+            .collect::<Vec<_>>();
+        assert_eq!(ports, vec![None, None, None]);
+    }
+}
