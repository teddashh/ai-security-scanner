+#[tokio::test]
+async fn security_message_coerces_decimal_string_ports_without_wrapping() {
+    let mut t = TestBuilder::default();
+    t.run_all(
+        r###"
+        security_message(data: "string port", port: "8080");
+        security_message(data: "highest port", port: "65535");
+        security_message(data: "i16 boundary port", port: 32768);
+        security_message(data: "highest numeric port", port: 65535);
+        security_message(data: "zero port", port: 0);
+        security_message(data: "negative port", port: -1);
+        security_message(data: "oversized port", port: 65536);
+        "###,
+    );
+    t.check_no_errors();
+
+    let (_, ctx) = t.results_and_ctx();
+    for (id, expected) in [
+        (0, Some(8080)),
+        (1, Some(65535)),
+        (2, Some(32768)),
+        (3, Some(65535)),
+        (4, None),
+        (5, None),
+        (6, None),
+    ] {
+        let result = ctx
+            .storage()
+            .retrieve(&(ctx.scan().clone(), id))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(result.port, expected);
+    }
+    drop(ctx);
+    t.async_verify().await;
+}
