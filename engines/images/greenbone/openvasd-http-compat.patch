 fn build_encode_url(keyword: Method, item: String, httpver: &str) -> String {
-    format!("{keyword} {item} {httpver} ")
+    format!("{keyword} {item} {httpver}")
+}
+
+fn host_header(hostname: &str, port: u16) -> String {
+    match port {
+        80 | 443 => hostname.to_string(),
+        _ => format!("{hostname}:{port}"),
+    }
+}
+
+fn auth_value(items: &[KbItem]) -> Option<String> {
+    match items.first() {
+        Some(KbItem::String(value)) => Some(value.clone()),
+        Some(KbItem::Data(value)) => Some(String::from_utf8_lossy(value).into_owned()),
+        _ => None,
+    }
+}
+
+fn append_auth_and_data(request: &mut String, auth: Option<&str>, data: Option<&str>) {
+    if let Some(auth) = auth {
+        request.push_str(auth);
+        request.push_str("\r\n");
+    }
+
+    match data {
+        Some(data) => {
+            request.push_str(&format!("Content-Length: {}\r\n\r\n", data.len()));
+            request.push_str(data);
+        }
+        None => request.push_str("\r\n"),
+    }
 }
 
