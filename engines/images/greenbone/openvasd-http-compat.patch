+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn request_line_and_non_default_host_match_legacy_http_format() {
+        assert_eq!(
+            build_encode_url(Method::GET, "/status".to_string(), "HTTP/1.0"),
+            "GET /status HTTP/1.0"
+        );
+        assert_eq!(host_header("192.0.2.10", 8080), "192.0.2.10:8080");
+        assert_eq!(host_header("192.0.2.10", 80), "192.0.2.10");
+    }
+
+    #[test]
+    fn request_without_auth_has_only_the_terminal_blank_line() {
+        let mut request = format!(
+            "{}\r\n",
+            build_encode_url(Method::GET, "/".to_string(), "HTTP/1.0")
+        );
+        append_auth_and_data(&mut request, None, None);
+        assert_eq!(request, "GET / HTTP/1.0\r\n\r\n");
+        assert!(!request.contains("http/auth"));
+    }
+
+    #[test]
+    fn authenticated_request_includes_the_complete_body() {
+        let mut request = format!(
+            "{}\r\n",
+            build_encode_url(Method::POST, "/submit".to_string(), "HTTP/1.0")
+        );
+        append_auth_and_data(
+            &mut request,
+            Some("Authorization: Basic dGVzdDp0ZXN0"),
+            Some("name=value"),
+        );
+        assert_eq!(
+            request,
+            "POST /submit HTTP/1.0\r\nAuthorization: Basic dGVzdDp0ZXN0\r\nContent-Length: 10\r\n\r\nname=value"
+        );
+    }
+
+    #[test]
+    fn auth_accepts_legacy_string_and_data_kb_values() {
+        assert_eq!(
+            auth_value(&[KbItem::String("Authorization: one".to_string())]),
+            Some("Authorization: one".to_string())
+        );
+        assert_eq!(
+            auth_value(&[KbItem::Data(b"Authorization: two".to_vec())]),
+            Some("Authorization: two".to_string())
+        );
+        assert_eq!(auth_value(&[]), None);
+    }
+}
