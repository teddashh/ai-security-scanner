{
  "name": "ai-security-scanner",
  "private": true,
  "version": "0.1.8",
  "release": {
    "channel": "prerelease",
    "target": "0.2.0"
  },
  "description": "One guided desktop app for security checks across websites, networks, code, IaC, cloud, containers, and Kubernetes.",
  "license": "Apache-2.0",
  "author": "Ted Huang and ai-security-scanner contributors",
  "homepage": "https://github.com/teddashh/ai-security-scanner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teddashh/ai-security-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/teddashh/ai-security-scanner/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.ts",
    "test:component": "vitest run --config vitest.config.ts",
    "test:release-evidence": "node --test tests/release/*.test.mjs",
    "test:usability-evidence": "node --test tests/usability/*.test.mjs",
    "validate:aidefend": "node scripts/validate-aidefend-snapshot.mjs",
    "validate:engine-line-endings": "node scripts/validate-engine-line-endings.mjs",
    "validate:engines": "node scripts/validate-engine-line-endings.mjs && node scripts/validate-engine-catalog.mjs && node --test tests/engines/prowlerCatalogContract.test.mjs",
    "validate:usability-evidence": "node scripts/validate-usability-evidence.mjs",
    "desktop:prepare-sidecar": "node scripts/release/build-sidecar.mjs",
    "desktop:check": "node scripts/release/check-desktop.mjs",
    "release:validate": "node scripts/release/validate-release.mjs",
    "release:notices": "node scripts/release/generate-notices.mjs",
    "release:self-test": "node scripts/release/self-test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "yaml": "2.9.0"
  }
}
