{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-security-scanner",
  "version": "0.1.8",
  "identifier": "dev.teddashh.ai-security-scanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ai-security-scanner",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ai-security-scanner-egress-gateway",
      "binaries/ai-security-scanner-bootstrap-broker",
      "binaries/ai-security-scanner-cli"
    ],
    "resources": {
      "../runtime/staged/managed-runtime/": "managed-runtime/"
    },
    "createUpdaterArtifacts": true,
    "publisher": "ai-security-scanner contributors",
    "copyright": "Copyright 2026 Ted Huang and ai-security-scanner contributors",
    "homepage": "https://github.com/teddashh/ai-security-scanner",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Local-first security assessment casework",
    "longDescription": "Discover assets, coordinate open-source security scanners, preserve evidence, hand off a case, and verify remediation without claiming a compliance audit."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQzI1RTVEMTJCMzJCRkUKUldUK0s3TVNYVjdDc3M2QU9nbGdqRTNQVStNR3hRQStuZEFQNStac2Y2U0FsQmZ5cjB5UTNHUmIK",
      "endpoints": [
        "https://github.com/teddashh/ai-security-scanner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
