{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/teddashh/ai-security-scanner/blob/main/mappings/control-mappings.schema.json",
  "title": "ai-security-scanner evidence-to-control mapping catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_version",
    "relationship",
    "disclaimer",
    "sources",
    "controls",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "mapping_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "relationship": { "const": "related" },
    "disclaimer": { "type": "string", "minLength": 40, "maxLength": 512 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "framework_version", "url"],
        "properties": {
          "framework": { "type": "string", "minLength": 1, "maxLength": 80 },
          "framework_version": { "type": "string", "minLength": 1, "maxLength": 40 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "framework", "framework_version", "control_id", "title"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$" },
          "framework": { "type": "string", "minLength": 1, "maxLength": 80 },
          "framework_version": { "type": "string", "minLength": 1, "maxLength": 40 },
          "control_id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "aidefend_applicability": {
            "enum": ["ai_system", "ai_generated_artifact"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "framework": { "const": "AIDEFEND" } },
              "required": ["framework"]
            },
            "then": { "required": ["aidefend_applicability"] },
            "else": { "not": { "required": ["aidefend_applicability"] } }
          }
        ]
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["engine_id", "match_kind", "source_rule", "controls", "rationale"],
        "properties": {
          "engine_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "match_kind": { "enum": ["exact", "prefix"] },
          "source_rule": { "type": "string", "minLength": 1, "maxLength": 512 },
          "controls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "rationale": { "type": "string", "minLength": 20, "maxLength": 512 }
        }
      }
    }
  }
}
