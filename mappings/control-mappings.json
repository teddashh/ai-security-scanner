  "entries": [
    {
      "engine_id": "steampipe",
      "match_kind": "exact",
      "source_rule": "aws_s3_bucket_public_access_blocked",
      "controls": ["nist-pr-aa-05", "iso-5-15", "iso-5-23"],
      "rationale": "Evidence that an object-storage resource permits public access is related to access policy, authorization review, and cloud service protection."
    },
    {
      "engine_id": "prowler",
      "match_kind": "exact",
      "source_rule": "s3_bucket_level_public_access_block",
      "controls": ["nist-pr-aa-05", "iso-5-15", "iso-5-23"],
      "rationale": "Evidence that an object-storage resource permits public access is related to access policy, authorization review, and cloud service protection."
    },
    {
      "engine_id": "scoutsuite",
      "match_kind": "exact",
      "source_rule": "s3-bucket-public-access",
      "controls": ["nist-pr-aa-05", "iso-5-15", "iso-5-23"],
      "rationale": "Evidence that an object-storage resource permits public access is related to access policy, authorization review, and cloud service protection."
    },
    {
      "engine_id": "cloudsplaining",
      "match_kind": "exact",
      "source_rule": "iam-privesc",
      "controls": ["nist-pr-aa-05", "iso-5-18", "iso-8-2"],
      "rationale": "Evidence of an identity privilege-escalation path is related to least privilege, entitlement review, and privileged access safeguards."
    },
    {
      "engine_id": "scubagear",
      "match_kind": "exact",
      "source_rule": "MS.AAD.1.1v1",
      "controls": ["nist-pr-aa-03", "iso-5-17"],
      "rationale": "Evidence that legacy authentication is not blocked is related to enforcing appropriate authentication and protecting authentication information."
    },
    {
      "engine_id": "maester",
      "match_kind": "exact",
      "source_rule": "MT.1001",
      "controls": ["nist-pr-aa-03", "iso-5-17"],
      "rationale": "Evidence that privileged identities lack phishing-resistant authentication is related to authentication enforcement and authentication information safeguards."
    },
    {
      "engine_id": "nuclei",
      "match_kind": "exact",
      "source_rule": "exposed-panel",
      "controls": ["nist-id-ra-01", "iso-8-8"],
      "rationale": "Evidence of an exposed administrative interface is related to identifying, validating, recording, and handling technical vulnerabilities."
    },
    {
      "engine_id": "semgrep",
      "match_kind": "exact",
      "source_rule": "python.lang.security.audit.exec-detected",
      "controls": ["nist-pr-ps-06", "iso-8-28", "iso-8-29"],
      "rationale": "Static-analysis evidence of dynamic code execution is related to secure development, secure coding, and security testing practices."
    },
    {
      "engine_id": "gitleaks",
      "match_kind": "exact",
      "source_rule": "generic-api-key",
      "controls": ["nist-pr-aa-01", "iso-5-17"],
      "rationale": "Evidence of a credential embedded in a repository is related to managing credentials and protecting authentication information."
    },
    {
      "engine_id": "trufflehog",
      "match_kind": "exact",
      "source_rule": "trufflehog:ExampleCredential",
      "controls": ["nist-pr-aa-01", "iso-5-17"],
      "rationale": "Evidence of a verified credential in source material is related to managing credentials and protecting authentication information."
    },
    {
      "engine_id": "checkov",
      "match_kind": "exact",
      "source_rule": "CKV_AWS_18",
      "controls": ["nist-pr-ps-04", "iso-8-15"],
      "rationale": "Infrastructure-as-code evidence that access logging is disabled is related to generating and retaining security-relevant audit records."
    },
    {
      "engine_id": "kics",
      "match_kind": "exact",
      "source_rule": "e24efb0e",
      "controls": ["nist-pr-ds-01", "iso-8-24"],
      "rationale": "Infrastructure-as-code evidence that server-side encryption is absent is related to protecting data at rest and using cryptographic safeguards."
    },
    {
      "engine_id": "trivy",
      "match_kind": "prefix",
      "source_rule": "CVE-",
      "controls": ["nist-id-ra-01", "iso-8-8"],
      "rationale": "Evidence that an installed component is affected by a CVE is related to identifying, recording, and handling technical vulnerabilities."
    },
    {
      "engine_id": "grype",
      "match_kind": "prefix",
      "source_rule": "CVE-",
      "controls": ["nist-id-ra-01", "iso-8-8"],
      "rationale": "Evidence that an installed component is affected by a CVE is related to identifying, recording, and handling technical vulnerabilities."
    },
    {
      "engine_id": "kubescape",
      "match_kind": "exact",
      "source_rule": "C-0002",
      "controls": ["nist-pr-aa-05", "iso-8-2"],
      "rationale": "Evidence of a privileged container is related to least-privilege authorization and privileged access safeguards."
    },
    {
      "engine_id": "kube-bench",
      "match_kind": "exact",
      "source_rule": "1.2.1",
      "controls": ["nist-pr-aa-03", "iso-5-17"],
      "rationale": "Evidence that anonymous API authentication is enabled is related to authentication enforcement and authentication information safeguards."
    }
